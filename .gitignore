extracted_pixel8pro/
dex/

# ADB uiautomator window dump XML files
*dump*.xml
*.dump.xml
live_dump.xml
live_portrait_dump.xml
window_dump*.xml

# Reverse-Engineering Tools & Binaries
# ------------------------------------------------------------------------------
tools/
scratch/

